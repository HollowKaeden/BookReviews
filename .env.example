# Формат: postgresql+psycopg://<user>:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql+psycopg://bookreviews:bookreviews@localhost:5433/bookreviews

# Доступ владельца к /admin и мутирующим ручкам (HTTP Basic).
# Пароль обязателен, без него приложение не стартует.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
